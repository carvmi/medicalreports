meta {
  name: Create a new address
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/addresses/
  body: json
  auth: inherit
}

body:json {
  {
    "rua": "Rua A",
    "cep": "50000000",
    "bairro": "Centro",
    "cidade": "Recife",
    "uf": "PE",
    "number": "100"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
